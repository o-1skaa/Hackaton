# Локальный демонстрационный ключ документов.
DEMO_API_KEY=demo-local-key
# Authorization Key из кабинета GigaChat API, без префикса Basic.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Необязательно: абсолютный путь к PEM-сертификату НУЦ Минцифры.
GIGACHAT_CA_BUNDLE_FILE=
